<!-- Somente o nuget.org: build reprodutível localmente e no CI, sem depender de feeds da máquina (SQ-11). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
